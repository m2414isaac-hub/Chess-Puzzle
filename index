  const PIECE_GLYPHS = {
    K: '♔', Q: '♕', R: '♖', B: '♗', N: '♘', P: '♙',
    k: '♚', q: '♛', r: '♜', b: '♝', n: '♞', p: '♟'
  };
  const DIFF_POINTS = { easy: 10, medium: 20, hard: 30 };
  const WRONG_PENALTY = 5;

  const ALL_PUZZLES = [
    { fen: "6k1/5ppp/8/8/8/8/8/R3K3 w - - 0 1", solution: ["a1a8"], difficulty: "easy", promptKo: "외통수를 찾아보세요", promptEn: "Find the checkmate", hintKo: "룩이 8번째 랭크로 들어가면 흑 킹은 폰에 갇힙니다.", hintEn: "Once the rook reaches the 8th rank, the black king is trapped." },
