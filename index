    if (solved) return;
    const r = Number(e.currentTarget.dataset.r);
    const c = Number(e.currentTarget.dataset.c);
    const piece = board[r][c];

    if (selected) {
      const isTarget = legalTargets.some(function (t2) { return t2[0] === r && t2[1] === c; });
      if (isTarget) { attemptMove(selected[0], selected[1], r, c); return; }
      if (piece && ((playerColor === 'w' && isWhite(piece)) || (playerColor === 'b' && isBlack(piece)))) {
        selected = [r, c];
        legalTargets = generateMoves(board, r, c);
        render();
        return;
      }
      selected = null; legalTargets = []; render();
      return;
    }

    if (piece && ((playerColor === 'w' && isWhite(piece)) || (playerColor === 'b' && isBlack(piece)))) {
      selected = [r, c];
      legalTargets = generateMoves(board, r, c);
      render();
    }
  }

  function attemptMove(fr, fc, tr, tc) {
    const s = t();
    const p = currentPuzzle();
    const moveStr = sqName(fr, fc) + sqName(tr, tc);
    const isCorrect = p.solution[0] === moveStr;
    const piece = board[fr][fc];
    const targetPiece = board[tr][tc];

    if (isCorrect) {
      if (targetPiece) sounds.capture.play().catch(()=>{});
      else sounds.move.play().catch(()=>{});
      setTimeout(() => sounds.correct.play().catch(()=>{}), 300);

      board[tr][tc] = piece; board[fr][fc] = null;
      selected = null; legalTargets = []; solved = true;
      render();
      flashSquare(tr, tc, 'good');
      const pts = DIFF_POINTS[p.difficulty];
      score += pts;
      scoreEl.textContent = score;
      progressFillEl.style.width = Math.round(((puzzleIndex + 1) / currentSessionPuzzles.length) * 100) + '%';
      const pieceName = s.pieces[piece.toUpperCase()];
      feedbackEl.textContent = s.correct(pieceName, sqName(fr, fc), sqName(tr, tc), pts);
      feedbackEl.className = 'feedback good';
      hintBtn.disabled = true; revealBtn.disabled = true;
      nextRow.classList.add('show');
    } else {
      sounds.wrong.play().catch(()=>{});
      flashSquare(tr, tc, 'bad');
      score = Math.max(0, score - WRONG_PENALTY);
      scoreEl.textContent = score;
      feedbackEl.textContent = s.wrong(WRONG_PENALTY);
      feedbackEl.className = 'feedback bad';
      selected = null; legalTargets = [];
      render();
    }
  }

  function flashSquare(r, c, kind) {
    const idx = r * 8 + c;
    const cell = boardEl.children[idx];
    if (!cell) return;
    cell.classList.add(kind === 'good' ? 'flash-good' : 'flash-bad');
    setTimeout(function () { cell.classList.remove('flash-good', 'flash-bad'); }, 650);
  }

  hintBtn.addEventListener('click', function () {
    const s = t();
    const p = currentPuzzle();
    feedbackEl.textContent = s.hintText(lang === 'ko' ? p.hintKo : p.hintEn);
    feedbackEl.className = 'feedback';
  });

  revealBtn.addEventListener('click', function () {
    if (solved) return;
    const s = t();
    const p = currentPuzzle();
    const from = p.solution[0].slice(0, 2), to = p.solution[0].slice(2, 4);
    const fr = 8 - Number(from[1]), fc = from.charCodeAt(0) - 97;
    const tr = 8 - Number(to[1]), tc = to.charCodeAt(0) - 97;
    const piece = board[fr][fc];
    
    board[tr][tc] = piece; board[fr][fc] = null;
    selected = null; legalTargets = []; solved = true;
    render();
    flashSquare(tr, tc, 'good');
    const pieceName = s.pieces[piece.toUpperCase()];
    feedbackEl.textContent = s.revealText(pieceName, from, to);
    feedbackEl.className = 'feedback';
    hintBtn.disabled = true; revealBtn.disabled = true;
    nextRow.classList.add('show');
  });

  nextBtn.addEventListener('click', function () {
    puzzleIndex += 1;
    if (puzzleIndex >= currentSessionPuzzles.length) {
      document.querySelector('.layout').style.display = 'none';
      doneSummary.textContent = t().doneSummary(score, currentSessionPuzzles.length);
      doneCard.classList.add('show');
      return;
    }
    loadPuzzle();
  });

  function shuffle(array) {
    let currentIndex = array.length, randomIndex;
    while (currentIndex !== 0) {
      randomIndex = Math.floor(Math.random() * currentIndex);
      currentIndex--;
      [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
    }
    return array;
  }

  function startNewSession() {
    const easys = shuffle(ALL_PUZZLES.filter(p => p.difficulty === 'easy')).slice(0, 5);
    const mediums = shuffle(ALL_PUZZLES.filter(p => p.difficulty === 'medium')).slice(0, 5);
    const hards = shuffle(ALL_PUZZLES.filter(p => p.difficulty === 'hard')).slice(0, 5);

    currentSessionPuzzles = [].concat(easys, mediums, hards);

    puzzleIndex = 0; 
    score = 0;
    scoreEl.textContent = '0';
    document.querySelector('.layout').style.display = 'grid';
    doneCard.classList.remove('show');
    loadPuzzle();
  }

  resetBtn.addEventListener('click', startNewSession);
  restartBtn.addEventListener('click', startNewSession);
  langKoBtn.addEventListener('click', function () { setLang('ko'); });
  langEnBtn.addEventListener('click', function () { setLang('en'); });

  applyStaticStrings();
  startNewSession();
})();
</script>
</body>
</html>
