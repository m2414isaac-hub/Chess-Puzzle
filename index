      fileLabelsEl.appendChild(s);
    });
  }

  function render() {
    boardEl.innerHTML = '';
    for (let r = 0; r < 8; r++) {
      for (let c = 0; c < 8; c++) {
        const cell = document.createElement('div');
        const isLight = (r + c) % 2 === 0;
        cell.className = 'sq ' + (isLight ? 'light' : 'dark');
        cell.dataset.r = r;
        cell.dataset.c = c;
        const piece = board[r][c];
        if (piece) {
          const span = document.createElement('span');
          span.className = 'piece ' + (isWhite(piece) ? 'white-piece' : 'black-piece');
          span.textContent = PIECE_GLYPHS[piece];
          cell.appendChild(span);
        }
        if (selected && selected[0] === r && selected[1] === c) cell.classList.add('selected');
        if (legalTargets.some(function (t2) { return t2[0] === r && t2[1] === c; })) {
          const dot = document.createElement('div');
          dot.className = 'legal-dot' + (piece ? ' capture' : '');
          cell.appendChild(dot);
        }
        cell.addEventListener('click', onSquareClick);
        boardEl.appendChild(cell);
      }
    }
  }

