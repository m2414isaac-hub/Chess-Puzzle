  function loadPuzzle() {
    const p = currentPuzzle();
    board = parseFEN(p.fen);
    playerColor = p.fen.split(' ')[1] || 'w';
    selected = null;
    legalTargets = [];
    solved = false;
    feedbackEl.textContent = '';
    feedbackEl.className = 'feedback';
    diffDotEl.className = 'difficulty-dot ' + p.difficulty;
    progressTextEl.textContent = (puzzleIndex + 1) + ' / ' + currentSessionPuzzles.length;
    progressFillEl.style.width = Math.round((puzzleIndex / currentSessionPuzzles.length) * 100) + '%';
    hintBtn.disabled = false;
    revealBtn.disabled = false;
    nextRow.classList.remove('show');
    doneCard.classList.remove('show');
    applyPuzzleStrings();
    renderLabels();
    render();
